rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isPlatformOwner() {
      return request.auth != null
        && request.auth.token.platformOwner == true
        && request.auth.token.ownerEmail == 'yallacodex@gmail.com'
        && request.auth.token.ownerUid == request.auth.uid
        && request.auth.token.email_verified == true;
    }

    // The platform owner can operate the existing administrative collections.
    // Other existing clinic/patient rules below retain their current behavior.
    match /{document=**} {
      allow read, write: if isPlatformOwner();
    }
    match /site_settings/landing_page {
      allow get: if true;
      allow list, write: if false;
    }
    // Submissions use validated server routes; no public reads of pending reviews or leads.
    match /landing_feedback/{id} { allow read, write: if isPlatformOwner(); }
    match /trial_requests/{id} { allow read, write: if isPlatformOwner(); }
    match /landing_rate_limits/{id} { allow read, write: if false; }

    // By default, deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Clinics Collection
    match /clinics/{clinicId} {
      // Anyone can read clinic public info for booking
      allow read: if true;
      // Only authenticated users (admins) can write to their clinic
      // In a real app, verify request.auth.uid == resource.data.owner_uid
      // For this SaaS demo, we allow write for authenticated users
      allow write: if request.auth != null;
    }

    // Appointments Collection
    match /appointments/{apptId} {
      // Patients can read their own appointments, admins can read all for their clinic
      allow read: if true; // In production: if request.auth != null || resource.data.phone == request.auth.token.phone
      // Anyone can create an appointment (online booking)
      allow create: if true;
      // Only admins can update/delete (change status, add diagnosis, etc.)
      allow update, delete: if true; // In production: restrict to clinic admin
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true; // Simplified for demo
    }
  }
}
